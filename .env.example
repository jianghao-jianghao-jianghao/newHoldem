# Server Port & Runtime Mode
PORT=3000
NODE_ENV=production

# SQLite & Session Secret storage directory (mounted as Docker volume /app/data)
DATA_DIR=./data

# Reverse proxy & CORS settings
TRUST_PROXY=0
CORS_ORIGIN=*

# VITE_SERVER_URL: Optional external WebSocket/API server base URL (leave empty for same-origin).
VITE_SERVER_URL=""

# AUTH_SESSION_SECRET: Strong random hex secret (>= 32 chars) for signing login session tokens.
AUTH_SESSION_SECRET=""

# ALLOW_OTP_PREVIEW: Set to "true" ONLY for private testing when no email provider is configured.
ALLOW_OTP_PREVIEW=false

# Optional Email Delivery (Resend or SMTP) for 6-digit verification code login.
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Optional DeepSeek API for AI practice bots table chat, GTO Coach & Persona fallback.
# Players can also optionally configure a room-scoped key in the chat settings panel.
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# Gemini API key for server-side AI player persona radar & data-driven coaching (POST /api/persona/analyze).
# If omitted while DEEPSEEK_API_KEY is set, persona analysis automatically falls back to DeepSeek.
GEMINI_API_KEY=""
GEMINI_MODEL=""

# Optional Layer-3 TexasSolver CLI binary path (e.g. /usr/local/bin/console_solver) for DCFR subgame solving.
TEXASSOLVER_BIN=""

# Optional hybrid LLM tactical overlay for high-leverage postflop bot spots (requires DEEPSEEK_API_KEY).
AI_BOT_ENHANCEMENT=false

