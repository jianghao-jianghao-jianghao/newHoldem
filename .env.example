# Server Port & Runtime Mode
PORT=3000
NODE_ENV=production

# SQLite & Session Secret storage directory (mounted as Docker volume /app/data)
DATA_DIR=./data

# Reverse proxy & CORS settings
# Set TRUST_PROXY=1 when deployed behind Nginx / Caddy / Cloudflare
TRUST_PROXY=0
# Comma-separated allowed origins (leave "*" for open access or set "https://poker.example.com")
CORS_ORIGIN=*

# VITE_SERVER_URL: Optional external WebSocket/API server base URL (e.g. https://poker.example.com).
# Leave empty for single-container same-origin deployment.
VITE_SERVER_URL=""

# AUTH_SESSION_SECRET: Strong random hex secret (>= 32 chars) for signing login session tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET=""

# ALLOW_OTP_PREVIEW: Set to "true" ONLY for private testing when no email provider is configured.
# In production, leaving this false/unset enforces real email delivery via Resend or SMTP.
ALLOW_OTP_PREVIEW=false

# Optional Email Delivery (Resend or SMTP) for 6-digit verification code login.
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Optional DeepSeek LLM Coach (used by POST /api/gto/evaluate when useLlm: true)
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"
