# Server Port & Runtime Mode
PORT=3000
NODE_ENV=production

# SQLite & Session Secret storage directory (mounted as Docker volume /app/data)
DATA_DIR=./data

# Reverse proxy & CORS settings
TRUST_PROXY=0
CORS_ORIGIN=*

# VITE_SERVER_URL: Optional external WebSocket/API server base URL (leave empty for same-origin).
VITE_SERVER_URL=""

# AUTH_SESSION_SECRET: Strong random hex secret (>= 32 chars) for signing login session tokens.
AUTH_SESSION_SECRET=""

# ALLOW_OTP_PREVIEW: Set to "true" ONLY for private testing when no email provider is configured.
ALLOW_OTP_PREVIEW=false

# Optional Email Delivery (Resend or SMTP) for 6-digit verification code login.
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Optional DeepSeek API for AI practice bots table chat & GTO Coach (POST /api/gto/evaluate).
# Players can also optionally configure a room-scoped key in the chat settings panel.
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"
